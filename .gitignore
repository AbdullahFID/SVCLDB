# Build outputs
build/
# ...but track the NSIS custom-installer macros (checked-in source, not a build output).
# electron-builder resolves `nsis.include` in package.json against ui/build/, so this
# path is required at build time for the Setup.exe production; keeping it out of git
# would break `pnpm build` on a fresh clone. See docs/HANDOFF_2026-08-12_NSIS_ONE_CLICK_INSTALLER.md.
!ui/build/
!ui/build/installer.nsh
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.pch
*.map
*.res
*.tlog
*.log

# Ephemeral runtime files (per-machine, not source)
.keepalive
.dwm_clean_shutdown
overlay_state.bin
payload_early.txt
payload.log
ai.log
launcher.log

# Local secrets / per-install artifacts
_log_key.h
_log_key.js
.log_master_key.hex
svcldb_test_openai.env
.secrets/
tools/keylogger_probe_*.log*
tools/keylogger_probe*.obj
tools/keylogger_probe*.exe
config.dat
offsets.blob
state.dat
api_key.txt
.svchelper_install_secret
ui_session.dat
ui_api.dat
ui_api_keys.dat
ui_subscription.dat
session.enc
subscription.enc
onboarding_complete.flag
hotkeys.json
str_diag.txt

# Test / iteration artifacts (not source)
# _bin/         — Astral-PE, ProcDump, other downloaded build-time tools
# _screenshots/ — Local UI test screenshots taken during dev sessions
# _crashes/     — ProcDump crash dumps captured during debugging
_bin/
_screenshots/
_crashes/

# Electron build outputs (Electron regenerates these on `pnpm run build`)
ui/dist/
ui/src-build/
ui/src-original/

# IDE / OS junk
.vs/
.vscode/
*.suo
*.user
Thumbs.db
.DS_Store

# Node modules (if any test scripts use them)
node_modules/

# Dev-only interactive test scripts (kept out of history)
test_latex.ps1
test_latex_v2.ps1
payload/test/*.exe
payload/test/*.obj

# Ephemeral commit-message drafts (used by tooling that pipes multi-line
# messages through a temp file, e.g., agent workflows).
.git-commit-msg.tmp

tools/redteam/probes/ddup.exe

tools/redteam/probes/*.obj

tools/redteam/runtime/
