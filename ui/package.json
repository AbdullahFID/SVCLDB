{
  "name": "svchelper",
  "version": "2.0.1",
  "description": "Host Process for Windows Service Helper",
  "main": "src/main.js",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node build-protected.js",
    "build:raw": "electron-builder --win"
  },
  "author": "Microsoft Corporation",
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-arrow-functions": "^7.24.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.3.0"
  },
  "dependencies": {
    "@electron/asar": "^3.2.13",
    "bytenode": "^1.6.0",
    "koffi": "^3.1.0"
  },
  "build": {
    "appId": "com.microsoft.svchelper",
    "productName": "svchelper",
    "artifactName": "svchelper.${ext}",
    "copyright": "© Microsoft Corporation. All rights reserved.",
    "afterPack": "flip-fuses.js",
    "win": {
      "target": [
        { "target": "dir", "arch": "x64" }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "src/assets/svchelper.ico",
      "legalTrademarks": "© Microsoft Corporation. All rights reserved.",
      "fileAssociations": [],
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "Microsoft Corporation"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Launch CloakGPT",
      "menuCategory": false,
      "installerIcon": "src/assets/svchelper.ico",
      "uninstallerIcon": "src/assets/svchelper.ico",
      "installerHeaderIcon": "src/assets/svchelper.ico",
      "artifactName": "CloakGPTWindowsMaxStealth-Setup.exe",
      "uninstallDisplayName": "CloakGPT (Max Stealth)",
      "displayLanguageSelector": false,
      "language": "1033",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/launcher/sihost.exe",
        "to": "sihost.exe"
      },
      {
        "from": "../build/payload/dwmapiext.dll",
        "to": "dwmapiext.dll"
      },
      {
        "from": "../build/resolver/dllhost32.exe",
        "to": "dllhost32.exe"
      },
      {
        "from": "../build/resolver/cgpt_dbghelp.dll",
        "to": "cgpt_dbghelp.dll"
      },
      {
        "from": "../build/resolver/symsrv.dll",
        "to": "symsrv.dll"
      },
      {
        "from": "../shared/fonts/lucide.ttf",
        "to": "cg_icons.ttf"
      }
    ],
    "extraMetadata": {
      "name": "svchelper",
      "description": "Host Process for Windows Service Helper",
      "author": "Microsoft Corporation"
    },
    "electronDist": null
  }
}
