# pnpm settings — electron-builder needs a flat node_modules layout
# (its packaging step follows real filesystem paths, not pnpm symlinks).
# Confirmed working with electron-builder 25.x + pnpm 9.x/10.x.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true

# Reduce install noise + skip devDeps of transitive packages.
loglevel=warn
